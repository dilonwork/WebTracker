# ============================================================
# WebTracker 環境變數範本
# 用法：cp .env.example .env，然後填入實際值
# .env 已加入 .gitignore，不會被 commit；
# 內網 IP、帳號密碼等敏感資訊請只放在 .env
# ============================================================

# ---------- 資料庫（必填，沒有預設值）----------
# PostgreSQL 連線資訊
DB_HOST=your_db_host
DB_ACCOUNT=your_db_user
DB_PASSWORD=<redacted>

# ---------- 資料庫名稱（選填，預設 postgres）----------
DB_NAME=webtracker

# ---------- AI 分析用 Ollama（選填）----------
# Ollama 伺服器位址；不填則用程式預設值 http://localhost:11434
# 若 Ollama 跑在內網其他機器，在 .env 填入實際位址（勿 commit 真實 IP）
OLLAMA_URL=http://your-ollama-host:11434
# 使用的模型；不填則用程式預設值
OLLAMA_MODEL=batiai/gemma4-e4b:q4

# ---------- 連接埠（選填）----------
BACKEND_PORT=8888
FRONTEND_PORT=8080

# ---------- 時區（選填，預設 America/Phoenix）----------
TZ=America/Phoenix
